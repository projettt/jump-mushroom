[sub_resource type="GDScript" id="GDScript_rbqi2"]
script/source = "extends CharacterBody2D

const SPEED = 55.0
const PATROL_DISTANCE = 105.0
var dead := false
var direction := -1.0
var start_x: float
@onready var anim: AnimatedSprite2D = $AnimatedSprite2D

func _ready() -> void:
	add_to_group(\"mob\")
	start_x = position.x
	anim.sprite_frames = anim.sprite_frames.duplicate()
	anim.sprite_frames.set_animation_loop(\"dead\", false)
	anim.play(\"walk\")

func _physics_process(delta: float) -> void:
	if dead:
		return
	if not is_on_floor():
		velocity += get_gravity() * delta
	if is_on_wall() or (position.x - start_x) * direction >= PATROL_DISTANCE:
		direction *= -1.0
	velocity.x = direction * SPEED
	anim.flip_h = direction > 0.0
	move_and_slide()

func die() -> bool:
	if dead:
		return false
	dead = true
	velocity = Vector2.ZERO
	set_collision_layer_value(1, false)
	set_collision_mask_value(1, false)
	$CollisionShape2D.set_deferred(\"disabled\", true)
	anim.play(\"dead\")
	_remove_after_animation()
	return true

func _remove_after_animation() -> void:
	await anim.animation_finished
	queue_free()
"

